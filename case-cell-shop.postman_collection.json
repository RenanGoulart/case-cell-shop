{
  "info": {
    "_postman_id": "f6078de9-c341-4d0e-8f3a-9cb62660b0e1",
    "name": "CaseCellShop Backend - Manual Tests",
    "description": "Collection para testes manuais das rotas HTTP existentes da API CaseCellShop. Execute POST /checkout - accepted antes de GET /orders/{orderId}/status para preencher a variavel orderId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "case-product-001",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "manual-checkout-key-001",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "00000000-0000-4000-8000-000000000001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-request-id",
                "value": "{{$guid}}"
              },
              {
                "key": "x-correlation-id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('body is ok', function () { pm.expect(pm.response.json()).to.eql({ status: 'ok' }); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "GET /products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-request-id",
                "value": "{{$guid}}"
              },
              {
                "key": "x-correlation-id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Retorna 200 com array de produtos ou 204 se catalogo vazio. Header x-catalog-source indica database, cache ou database_fallback."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 204', function () { pm.expect([200, 204]).to.include(pm.response.code); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('body is products array', function () { pm.expect(body).to.be.an('array'); });",
                  "  if (body.length > 0) { pm.collectionVariables.set('productId', body[0].id); }",
                  "  pm.test('catalog source header exists', function () { pm.expect(pm.response.headers.get('x-catalog-source')).to.be.oneOf(['database', 'cache', 'database_fallback']); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Checkout",
      "item": [
        {
          "name": "POST /checkout - accepted",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "idempotency-key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "x-request-id",
                "value": "{{$guid}}"
              },
              {
                "key": "x-correlation-id",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["checkout"]
            },
            "description": "Inicia compra assincrona. Resposta esperada: 202 com orderId/status. Reexecutar com a mesma idempotency-key e mesmo body deve exercitar replay idempotente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 202', function () { pm.response.to.have.status(202); });",
                  "const body = pm.response.json();",
                  "pm.test('response has orderId and status', function () {",
                  "  pm.expect(body.orderId).to.be.a('string');",
                  "  pm.expect(['pending', 'processing', 'retrying', 'confirmed', 'failed']).to.include(body.status);",
                  "});",
                  "pm.collectionVariables.set('orderId', body.orderId);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /checkout - idempotency replay",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "idempotency-key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "x-request-id",
                "value": "{{$guid}}"
              },
              {
                "key": "x-correlation-id",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["checkout"]
            },
            "description": "Use apos POST /checkout - accepted, sem alterar idempotencyKey nem body. Esperado: 202 com o mesmo contrato e sem criar compra duplicada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 202', function () { pm.response.to.have.status(202); });",
                  "pm.test('response has orderId', function () { pm.expect(pm.response.json().orderId).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /checkout - invalid body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "idempotency-key",
                "value": "invalid-body-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["checkout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('error envelope', function () { const body = pm.response.json(); pm.expect(body.code).to.be.a('string'); pm.expect(body.requestId).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /checkout - product not found",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "idempotency-key",
                "value": "missing-product-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"missing-product\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["checkout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('error envelope', function () { const body = pm.response.json(); pm.expect(body.code).to.be.a('string'); pm.expect(body.requestId).to.be.a('string'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "GET /orders/{orderId}/status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-request-id",
                "value": "{{$guid}}"
              },
              {
                "key": "x-correlation-id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "status"]
            },
            "description": "Acompanhe aqui o processamento depois de POST /checkout - accepted preencher orderId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('order status contract', function () {",
                  "  pm.expect(body.orderId).to.be.a('string');",
                  "  pm.expect(['pending', 'processing', 'retrying', 'confirmed', 'failed']).to.include(body.status);",
                  "  pm.expect(body.updatedAt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /orders/{orderId}/status - invalid uuid",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/not-a-uuid/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "not-a-uuid", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /orders/{orderId}/status - not found",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/00000000-0000-4000-8000-000000000404/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "00000000-0000-4000-8000-000000000404", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('error envelope', function () { const body = pm.response.json(); pm.expect(body.code).to.be.a('string'); pm.expect(body.requestId).to.be.a('string'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Observability and Docs",
      "item": [
        {
          "name": "GET /metrics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["metrics"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('prometheus text metrics', function () { pm.expect(pm.response.text()).to.include('casecellshop_'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /documentation/json",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/documentation/json",
              "host": ["{{baseUrl}}"],
              "path": ["documentation", "json"]
            },
            "description": "OpenAPI gerado pelo Fastify Swagger UI."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('openapi document', function () { const body = pm.response.json(); pm.expect(body.openapi).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /documentation",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/documentation",
              "host": ["{{baseUrl}}"],
              "path": ["documentation"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or redirect', function () { pm.expect([200, 301, 302]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
