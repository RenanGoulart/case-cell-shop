{
  "name": "case-cell-shop-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend modular da CaseCellShop para catálogo com cache e checkout assíncrono.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write package.json tsconfig.json vitest.config.ts eslint.config.mjs .prettierrc.json docker-compose.yml src/**/*.ts tests/**/*.ts",
    "format:check": "prettier --check package.json tsconfig.json vitest.config.ts eslint.config.mjs .prettierrc.json docker-compose.yml src/**/*.ts tests/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "amqplib": "^2.0.1",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "redis": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
