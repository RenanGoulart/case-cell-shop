generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  processing
  retrying
  confirmed
  failed

  @@map("order_status")
}

enum ReservationState {
  active
  consumed
  released

  @@map("reservation_state")
}

enum ProcessingAttemptResult {
  confirmed
  temporarily_unavailable
  unavailable
  timeout

  @@map("processing_attempt_result")
}

enum OutboxStatus {
  pending
  published

  @@map("outbox_status")
}

model Product {
  id                String      @id
  name              String
  priceCents        Int         @map("price_cents")
  currency          String
  availableQuantity Int         @map("available_quantity")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  orderItems        OrderItem[]

  @@map("products")
}

model CatalogState {
  id        Int      @id @default(1)
  version   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("catalog_state")
}

model Order {
  id                 String               @id @default(uuid()) @db.Uuid
  status             OrderStatus          @default(pending)
  requestId          String               @map("request_id") @db.Uuid
  correlationId      String               @map("correlation_id") @db.Uuid
  currentAttempt     Int                  @default(0) @map("current_attempt")
  finalError         String?              @map("final_error")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  items              OrderItem[]
  idempotencyRecords IdempotencyRecord[]
  reservations       StockReservation[]
  attempts           ProcessingAttempt[]
  outboxEvents       OutboxEvent[]

  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  productId      String  @map("product_id")
  quantity       Int
  unitPriceCents Int     @map("unit_price_cents")
  currency       String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique
  requestHash    String   @map("request_hash")
  canonicalBody  Json     @map("canonical_body")
  orderId        String?  @map("order_id") @db.Uuid
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  order          Order?   @relation(fields: [orderId], references: [id])

  @@index([expiresAt])
  @@map("idempotency_records")
}

model StockReservation {
  id         String             @id @default(uuid()) @db.Uuid
  orderId    String             @map("order_id") @db.Uuid
  state      ReservationState    @default(active)
  expiresAt  DateTime           @map("expires_at")
  consumedAt DateTime?          @map("consumed_at")
  releasedAt DateTime?          @map("released_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items      ReservationItem[]

  @@index([state, expiresAt])
  @@map("stock_reservations")
}

model ReservationItem {
  id            String           @id @default(uuid()) @db.Uuid
  reservationId String           @map("reservation_id") @db.Uuid
  productId     String           @map("product_id")
  quantity      Int
  reservation   StockReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([productId])
  @@map("reservation_items")
}

model ProcessingAttempt {
  id              String                   @id @default(uuid()) @db.Uuid
  orderId         String                   @map("order_id") @db.Uuid
  attemptNumber   Int                      @map("attempt_number")
  correlationId   String                   @map("correlation_id") @db.Uuid
  processingToken String                   @map("processing_token") @db.Uuid
  deadlineAt      DateTime                 @map("deadline_at")
  startedAt       DateTime                 @default(now()) @map("started_at")
  finishedAt      DateTime?                @map("finished_at")
  result          ProcessingAttemptResult?
  order           Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, attemptNumber])
  @@index([deadlineAt])
  @@map("processing_attempts")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  type          String
  payload       Json
  status        OutboxStatus @default(pending)
  availableAt   DateTime     @default(now()) @map("available_at")
  publishedAt   DateTime?    @map("published_at")
  lockToken     String?      @map("lock_token") @db.Uuid
  lockedUntil   DateTime?    @map("locked_until")
  createdAt     DateTime     @default(now()) @map("created_at")
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([lockToken])
  @@map("outbox_events")
}
