{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casecellshop.local/schemas/order-processing-message.schema.json",
  "title": "OrderProcessingMessage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "eventId",
    "orderId",
    "requestId",
    "correlationId",
    "attemptNumber",
    "occurredAt"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "attemptNumber": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
